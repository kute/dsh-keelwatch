# dependencies
node_modules/
.pnpm-store/

# The published entry points are committed on purpose: `dsh plugin add <git url>`
# runs no build script, so a repository without lib/ installs as a dead bundle.
# Regenerate with `pnpm build` before committing.

# tooling caches
*.tsbuildinfo
.pnpm-debug.log*
.vitest/

