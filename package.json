{
  "name": "@kute/dsh-keelwatch",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH plugin ecosystem operations layer: dependency drift radar, failure brake, and token/latency attribution",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "observability",
    "plugin-health"
  ],
  "license": "MIT",
  "author": "kute",
  "homepage": "https://github.com/kute/dsh-keelwatch#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kute/dsh-keelwatch"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0-0",
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@deepseek-ai/dsh-tools": "^0.2.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
