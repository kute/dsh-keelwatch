{
  "name": "@kutebai/dsh-keelwatch",
  "version": "0.4.2",
  "type": "module",
  "description": "DSH plugin ecosystem operations layer: dependency drift radar, failure brake, and token/latency attribution",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "observability",
    "plugin-health"
  ],
  "license": "MIT",
  "author": "kute",
  "homepage": "https://github.com/kute/dsh-keelwatch#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kute/dsh-keelwatch"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0-0",
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test",
    "market": "node scripts/market-index.mjs",
    "market:check": "node scripts/market-index.mjs --check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
